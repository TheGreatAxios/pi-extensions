{
	"name": "pi-protected-paths",
	"version": "0.1.0",
	"description": "Blocks write/edit to sensitive files (.env, .git, node_modules, SSH keys, credentials, and more)",
	"license": "MIT",
	"author": "Sawyer Cutler <sawyer@dirtroad.dev>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thegreataxios/pi-extensions.git",
		"directory": "pi-protected-paths"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"protected-paths",
		"security",
		"file-protection",
		"sensitive-files"
	],
	"type": "module",
	"main": "index.ts",
	"files": [
		"index.ts",
		"features/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"check": "tsc --noEmit",
		"clean": "echo 'nothing to clean'",
		"prepublishOnly": "bun run check"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.74.0"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"typescript": "~6.0.3"
	}
}
